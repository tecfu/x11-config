#!/bin/sh

# Make ~/.local/bin and ~/.cargo/bin visible to the whole session (xfsettingsd,
# xfwm4 etc.) so keyboard shortcuts can launch commands by plain name.
# .bashrc only affects terminal shells, NOT shortcut-launched processes.
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) PATH="$HOME/.local/bin:$PATH" ;;
esac
case ":$PATH:" in
  *":$HOME/.cargo/bin:"*) ;;
  *) PATH="$HOME/.cargo/bin:$PATH" ;;
esac

# Configuration
XREMAP_BIN="$HOME/.cargo/bin/xremap"
XREMAP_CONFIG="$HOME/dotfiles/x11-config/xremap.yml"
LOG_FILE="$HOME/xremap.log"

# --- Function to log ---
log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "$LOG_FILE"
}

log "Starting .xprofile..."

# --- xremap setup ---

# 1. Kill existing instances to prevent duplicates
if pgrep -x "xremap" > /dev/null; then
    log "Stopping existing xremap instances..."
    pkill -x xremap
    sleep 1
fi

# 2. Verify requirements
if [ ! -x "$XREMAP_BIN" ]; then
    log "ERROR: xremap binary not found at $XREMAP_BIN"
    exit 1
fi

if [ ! -f "$XREMAP_CONFIG" ]; then
    log "ERROR: config file not found at $XREMAP_CONFIG"
    exit 1
fi

# 3. Start xremap
log "Launching xremap..."
nohup "$XREMAP_BIN" --watch "$XREMAP_CONFIG" >> "$LOG_FILE" 2>&1 &

PID=$!
log "xremap started with PID $PID"

# --- Other startups ---
# Add other background processes here if needed
# sxhkd &
# xmodmap $HOME/dotfiles/x11-config/xmodmap &

log ".xprofile execution complete."
